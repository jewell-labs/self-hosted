{
  "id": "cloudflare",
  "summary": "Cloudflare Tunnel, Access, the one shared agent service token, and the host log stream. Tokens stay outside git.",
  "proofRequired": false,
  "match": {
    "os": [
      "darwin",
      "linux"
    ],
    "arch": [
      "arm64",
      "x64"
    ]
  },
  "assets": [
    {
      "path": "assets",
      "scope": "home",
      "kind": "payload"
    }
  ],
  "events": [
    {
      "type": "healthcheck",
      "name": "healthcheck"
    }
  ]
}
