{
  "id": "portless",
  "summary": "The core proxy. Host services are port {mcp}, port {llm}, port {decision}, and port {sshd}.",
  "proofRequired": true,
  "match": {
    "os": [
      "darwin",
      "linux"
    ],
    "arch": [
      "arm64",
      "x64"
    ]
  },
  "version": "0.18.1",
  "assets": [
    {
      "path": "assets",
      "scope": "home",
      "kind": "payload"
    }
  ],
  "events": [
    {
      "type": "healthcheck",
      "name": "healthcheck"
    }
  ]
}
