{
  "schema": "jewell-labs.self-hosted.catalog.v1",
  "plugins": [
    {
      "id": "baseline",
      "summary": "Record the host facts the other plugins just discovered.",
      "proofRequired": true,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-baseline"
      ],
      "validate": []
    },
    {
      "id": "mcp",
      "summary": "Serve mesh MCP tools declared under .agents. A non-loopback bind requires Cloudflare Access, and so does every destructive tool.",
      "proofRequired": true,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-mcp"
      ],
      "validate": []
    },
    {
      "id": "llm",
      "summary": "One llama.cpp server for this host. One resident model. Weights are the shared ~/.self-hosted/models/gguf library.",
      "proofRequired": false,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-llm"
      ],
      "validate": []
    },
    {
      "id": "decision",
      "summary": "Decision models and compound models, separate from the llm server. The registry is unbounded. Resident slots come from host memory.",
      "proofRequired": false,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-decision"
      ],
      "validate": []
    },
    {
      "id": "cloudflare",
      "summary": "Cloudflare Tunnel, Access, the one shared agent service token, and the host log stream. Tokens stay outside git.",
      "proofRequired": false,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-cloudflare"
      ],
      "validate": []
    },
    {
      "id": "sshd",
      "summary": "Userland sshd on port {sshd}. Passwords off. Trusts a Cloudflare Access SSH CA that stays outside git.",
      "proofRequired": false,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-sshd"
      ],
      "validate": []
    },
    {
      "id": "github-repos",
      "summary": "Sync the repos named in github-repos/config. The sync interval is interval_seconds in that file.",
      "proofRequired": false,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-github-repos"
      ],
      "validate": []
    },
    {
      "id": "agent-desktop",
      "summary": "agent-desktop CLI and the macOS sandbox provider. The first guest needs a person to grant Accessibility.",
      "proofRequired": false,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-agent-desktop"
      ],
      "validate": []
    },
    {
      "id": "agent-browser",
      "summary": "agent-browser CLI. Chrome for Testing is downloaded into the user directory, not into git.",
      "proofRequired": false,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-agent-browser"
      ],
      "validate": []
    },
    {
      "id": "actions-runner",
      "summary": "GitHub Actions self-hosted runner. Refuses a public repository unless the operator overrides it.",
      "proofRequired": false,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-actions-runner"
      ],
      "validate": []
    },
    {
      "id": "simulators",
      "summary": "Claim every available iOS simulator. A host with none records an empty list.",
      "proofRequired": false,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-simulators"
      ],
      "validate": []
    },
    {
      "id": "portless",
      "summary": "The core proxy. Host services are port {mcp}, port {llm}, port {decision}, and port {sshd}.",
      "proofRequired": true,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-portless"
      ],
      "validate": []
    },
    {
      "id": "work",
      "summary": "Short-lived clones under ~/.self-hosted/work. Each coding harness is a descriptor that is probed and then streamed.",
      "proofRequired": false,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-work"
      ],
      "validate": []
    },
    {
      "id": "evals",
      "summary": "Isolated container evals for the llm and the decision models. Every coding harness is graded against the same agents instructions.",
      "proofRequired": false,
      "match": {
        "os": [
          "darwin",
          "linux"
        ],
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "setup": [
        "nix run .#setup-evals"
      ],
      "validate": []
    }
  ]
}
