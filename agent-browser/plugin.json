{
  "id": "agent-browser",
  "summary": "agent-browser CLI. Chrome for Testing is downloaded into the user directory, not into git.",
  "proofRequired": false,
  "match": {
    "os": [
      "darwin",
      "linux"
    ],
    "arch": [
      "arm64",
      "x64"
    ]
  },
  "version": "0.43.0",
  "assets": [
    {
      "path": "assets",
      "scope": "home",
      "kind": "payload"
    }
  ],
  "events": [
    {
      "type": "healthcheck",
      "name": "healthcheck"
    }
  ]
}
