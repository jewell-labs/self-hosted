{
  "id": "work",
  "summary": "Short-lived clones under ~/.self-hosted/work. Each coding harness is a descriptor that is probed and then streamed.",
  "proofRequired": false,
  "match": {
    "os": [
      "darwin",
      "linux"
    ],
    "arch": [
      "arm64",
      "x64"
    ]
  },
  "assets": [
    {
      "path": "assets",
      "scope": "home",
      "kind": "payload"
    }
  ],
  "events": [
    {
      "type": "healthcheck",
      "name": "healthcheck"
    }
  ]
}
