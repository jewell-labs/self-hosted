{
  "schema": "jewell-labs.self-hosted.home.v1",
  "allowed": [
    "actions-runner",
    "agent-browser",
    "agent-desktop",
    "attach",
    "baseline",
    "bin",
    "cloudflare",
    "cloudflared",
    "containers",
    "decision",
    "evals",
    "ghref",
    "github",
    "github-repos",
    "launchd",
    "llm",
    "logs",
    "mcp",
    "opt",
    "portless",
    "simulators",
    "sshd",
    "state",
    "work"
  ],
  "heavy": ["llm/models", "agent-desktop", "containers"],
  "refuseNames": ["node_modules", ".pnpm-store"],
  "weights": "llm/models/gguf",
  "usageLog": "logs/models.jsonl",
  "usageKeep": 400,
  "diskReserveBytes": 21474836480,
  "maxDownloadBytes": 42949672960,
  "probes": [
    { "id": "pong", "text": "Reply with the single word pong.", "expect": "pong" },
    { "id": "sum", "text": "What is 2+2? Reply with one digit.", "expect": "4" }
  ]
}
