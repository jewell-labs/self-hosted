{
  "id": "agent-desktop",
  "summary": "agent-desktop CLI and the macOS sandbox provider. The first guest needs a person to grant Accessibility.",
  "proofRequired": false,
  "match": {
    "os": [
      "darwin",
      "linux"
    ],
    "arch": [
      "arm64",
      "x64"
    ]
  },
  "version": "1.3.1",
  "assets": [
    {
      "path": "assets",
      "scope": "home",
      "kind": "payload"
    },
    {
      "path": ".",
      "scope": "home",
      "kind": "store"
    }
  ],
  "events": [
    {
      "type": "healthcheck",
      "name": "healthcheck"
    }
  ]
}
