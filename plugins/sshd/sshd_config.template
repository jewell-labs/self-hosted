# Rendered by bin/setup.mjs into the host's ~/.ssh/userland. Do not commit that directory.
Port 2222
ListenAddress 127.0.0.1
HostKey {{dir}}/ssh_host_ed25519_key
PidFile {{dir}}/sshd.pid
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile {{dir}}/authorized_keys
AuthorizedPrincipalsFile {{dir}}/authorized_principals
TrustedUserCAKeys {{dir}}/cf-access-ca.pub
UsePAM no
StrictModes no
AllowTcpForwarding yes
